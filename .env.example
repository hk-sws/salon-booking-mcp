# ─────────────────────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# Seed the salon tenant automatically on boot if the DB is empty.
SEED_ON_START=true

# ─────────────────────────────────────────────────────────────
# Firestore
# ─────────────────────────────────────────────────────────────
# Any non-empty project id works for the local emulator.
# For the real project use: salon-agent-392ac  (region asia-south1)
GOOGLE_CLOUD_PROJECT=salon-mcp-local

# LOCAL DEV (emulator): point the client at the emulator. The
# docker-compose file sets this for you. When this is set, NO real
# GCP credentials are used or needed.
FIRESTORE_EMULATOR_HOST=localhost:8080

# PRODUCTION / real Cloud Firestore (Firebase project salon-agent-392ac):
#   1. Leave FIRESTORE_EMULATOR_HOST UNSET / empty.
#   2. Set GOOGLE_CLOUD_PROJECT=salon-agent-392ac
#   3. Provide the service-account key as a BASE64 string (no file on disk):
#        macOS/Linux:  base64 -i service-account.json | tr -d '\n'
#      then paste the output here:
# FIREBASE_SERVICE_ACCOUNT_BASE64=eyJ0eXBlIjoi...
#
# (Alternative: leave the above unset and use a JSON file via
#  GOOGLE_APPLICATION_CREDENTIALS=/secrets/firestore-sa.json)

# ─────────────────────────────────────────────────────────────
# Notifications (optional — console provider is the default)
# ─────────────────────────────────────────────────────────────
# NOTIFY_PROVIDER=console            # console | smtp | brevo

# --- Brevo (transactional email via HTTP API) ---
# Get the API key from Brevo dashboard -> SMTP & API -> API Keys.
# The sender EMAIL must be a verified sender/domain in your Brevo account.
# BREVO_API_KEY=xkeysib-xxxxxxxx
# BREVO_SENDER_EMAIL=no-reply@yourdomain.com
# BREVO_SENDER_NAME=Bloom Salon

# --- SMTP (alternative to the Brevo API; Brevo also offers an SMTP relay) ---
# For Brevo SMTP relay: SMTP_HOST=smtp-relay.brevo.com, SMTP_PORT=587,
# SMTP_USER=<your brevo login>, SMTP_PASS=<brevo SMTP key>.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Bloom Salon <no-reply@bloom.example>"
