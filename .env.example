# ─────────────────────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# Seed the salon tenant automatically on boot if the DB is empty.
SEED_ON_START=true

# ─────────────────────────────────────────────────────────────
# Firestore
# ─────────────────────────────────────────────────────────────
# Any non-empty project id works for the local emulator.
GOOGLE_CLOUD_PROJECT=salon-mcp-local

# LOCAL DEV (emulator): point the client at the emulator. The
# docker-compose file sets this for you. When this is set, NO real
# GCP credentials are used or needed.
FIRESTORE_EMULATOR_HOST=localhost:8080

# PRODUCTION (real Cloud Firestore, e.g. from Azure):
#   1. Leave FIRESTORE_EMULATOR_HOST UNSET / empty.
#   2. Set GOOGLE_CLOUD_PROJECT to your real GCP project id.
#   3. Provide a service-account key JSON and point this var at it:
# GOOGLE_APPLICATION_CREDENTIALS=/secrets/firestore-sa.json

# ─────────────────────────────────────────────────────────────
# Notifications (optional — console provider is the default)
# ─────────────────────────────────────────────────────────────
# NOTIFY_PROVIDER=console            # console | smtp
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Bloom Salon <no-reply@bloom.example>"

# ─────────────────────────────────────────────────────────────
# Rate limiting
# ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
